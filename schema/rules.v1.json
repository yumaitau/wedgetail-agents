{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wedgetail agent configuration, schema version 1",
  "description": "agent.toml and rules.d/*.toml for the Wedgetail host agent. rules.d files may only hold schema_version and [[rule]] tables. See docs/rules.md.",
  "type": "object",
  "properties": {
    "agent": {
      "description": "Agent settings (`agent.toml` only).",
      "anyOf": [
        {
          "$ref": "#/$defs/AgentSection"
        },
        {
          "type": "null"
        }
      ]
    },
    "buffer": {
      "description": "Deprecated: use `[agent] buffer_max_mb`.",
      "anyOf": [
        {
          "$ref": "#/$defs/BufferConfig"
        },
        {
          "type": "null"
        }
      ]
    },
    "endpoint": {
      "description": "Deprecated: use `[agent] endpoint`.",
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "heartbeat": {
      "description": "Heartbeat settings.",
      "anyOf": [
        {
          "$ref": "#/$defs/HeartbeatConfig"
        },
        {
          "type": "null"
        }
      ]
    },
    "limits": {
      "description": "Shipping limits; defaults are the server limits and can only be lowered.",
      "anyOf": [
        {
          "$ref": "#/$defs/Limits"
        },
        {
          "type": "null"
        }
      ]
    },
    "rule": {
      "description": "Collector rules.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Rule"
      }
    },
    "schema_version": {
      "description": "Schema version of this file. Only `1` exists; leaving it out means `1`.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "default": null,
      "minimum": 0
    },
    "state_dir": {
      "description": "Deprecated: use `[agent] state_dir`.",
      "type": [
        "string",
        "null"
      ],
      "default": null
    }
  },
  "additionalProperties": false,
  "$defs": {
    "AgentSection": {
      "description": "`[agent]`.",
      "type": "object",
      "properties": {
        "buffer_max_mb": {
          "description": "Disk buffer cap in MiB, 16 to 65536 (default 256).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "default": null,
          "minimum": 0
        },
        "disable_rules": {
          "description": "Rule ids (from presets or rule files) to switch off.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "endpoint": {
          "description": "Your Wedgetail ingest URL, `https://` only.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "max_open_files": {
          "description": "Most files tailed at once across all `file` rules, 1 to 100,000 (default 1,000).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "default": null,
          "minimum": 0
        },
        "presets": {
          "description": "Built-in presets: `\"auto\"` (default), a list of preset ids, or `[]` for none. `\"auto\"`\nin a list adds the presets detected for this host.",
          "anyOf": [
            {
              "$ref": "#/$defs/PresetSelection"
            },
            {
              "type": "null"
            }
          ]
        },
        "state_dir": {
          "description": "Disk buffer, checkpoints, status and credential. Defaults per OS.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false
    },
    "BufferConfig": {
      "description": "`[buffer]` (deprecated: use `[agent] buffer_max_mb`).",
      "type": "object",
      "properties": {
        "max_mb": {
          "description": "Disk buffer cap in MiB. When full, the oldest events are dropped and counted.",
          "type": "integer",
          "format": "uint64",
          "default": 256,
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "FileFormat": {
      "description": "How a `file` rule turns the bytes of a file into events.",
      "oneOf": [
        {
          "description": "Text lines (default), joined by `multiline` and parsed by `parser`.",
          "type": "string",
          "const": "lines"
        },
        {
          "description": "The Linux audit log: records with the same serial are merged into one event.",
          "type": "string",
          "const": "auditd"
        },
        {
          "description": "Binary login records (`/var/log/wtmp`, `/var/log/btmp`), glibc layout.",
          "type": "string",
          "const": "utmp"
        },
        {
          "description": "Binary `/var/log/lastlog`, sent as a periodic summary rather than raw records.",
          "type": "string",
          "const": "lastlog"
        }
      ]
    },
    "HeartbeatConfig": {
      "description": "`[heartbeat]`.",
      "type": "object",
      "properties": {
        "interval_s": {
          "description": "Seconds between `agent.heartbeat` events, 10 to 3600.",
          "type": "integer",
          "format": "uint64",
          "default": 60,
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "Limits": {
      "description": "Shipping limits. Defaults are the server limits; they can be lowered, not raised.",
      "type": "object",
      "properties": {
        "max_batch_bytes": {
          "description": "Largest gzip request body in bytes.",
          "type": "integer",
          "format": "uint64",
          "default": 1048576,
          "minimum": 0
        },
        "max_batch_records": {
          "description": "Most records in one request.",
          "type": "integer",
          "format": "uint32",
          "default": 5000,
          "minimum": 0
        },
        "max_batch_uncompressed_bytes": {
          "description": "Largest request body before compression, in bytes.",
          "type": "integer",
          "format": "uint64",
          "default": 8388608,
          "minimum": 0
        },
        "max_event_bytes": {
          "description": "Largest single event line in bytes; larger events are dropped and counted as oversize.",
          "type": "integer",
          "format": "uint64",
          "default": 262144,
          "minimum": 0
        },
        "max_requests_per_minute": {
          "description": "Most requests per rolling minute.",
          "type": "integer",
          "format": "uint32",
          "default": 120,
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "LogLevel": {
      "description": "`macos_unified`: the least severe level streamed.",
      "oneOf": [
        {
          "description": "Default-level messages and above.",
          "type": "string",
          "const": "default"
        },
        {
          "description": "Info and above (default).",
          "type": "string",
          "const": "info"
        },
        {
          "description": "Everything, including debug messages (noisy).",
          "type": "string",
          "const": "debug"
        }
      ]
    },
    "MultilineConfig": {
      "description": "`multiline = { pattern = '^\\d{4}-', negate = true, match = \"after\", max_lines = 500 }`.\n\nA line is a continuation when it matches `pattern` (or, with `negate`, when it does not).",
      "type": "object",
      "properties": {
        "match": {
          "description": "`after` (default) or `before`.",
          "$ref": "#/$defs/MultilineMatch"
        },
        "max_lines": {
          "description": "Most lines in one event (1 to 10,000, default 500).",
          "type": "integer",
          "format": "uint32",
          "default": 500,
          "minimum": 0
        },
        "negate": {
          "description": "Treat lines that do NOT match `pattern` as continuations.",
          "type": "boolean",
          "default": false
        },
        "pattern": {
          "description": "Regular expression tested against each line.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "pattern"
      ]
    },
    "MultilineMatch": {
      "description": "Which side of a matching line the continuation lines join.",
      "oneOf": [
        {
          "description": "Continuation lines join the line before them (default).",
          "type": "string",
          "const": "after"
        },
        {
          "description": "Continuation lines join the line after them.",
          "type": "string",
          "const": "before"
        }
      ]
    },
    "ParserKind": {
      "description": "How a `file` rule turns a line into `fields`.",
      "oneOf": [
        {
          "description": "No parsing: the line is sent as `body` only (default).",
          "type": "string",
          "const": "raw"
        },
        {
          "description": "One JSON object per line.",
          "type": "string",
          "const": "json"
        },
        {
          "description": "BSD syslog (`Oct 21 08:00:00 host app[pid]: message`, also with an RFC 3339 time).",
          "type": "string",
          "const": "syslog_rfc3164"
        },
        {
          "description": "RFC 5424 syslog (`<34>1 2026-10-21T08:00:00Z host app pid msgid [sd] message`).",
          "type": "string",
          "const": "syslog_rfc5424"
        },
        {
          "description": "ArcSight Common Event Format (`CEF:0|vendor|product|...|ext`).",
          "type": "string",
          "const": "cef"
        },
        {
          "description": "`key=value key2=\"quoted value\"`.",
          "type": "string",
          "const": "logfmt"
        },
        {
          "description": "The rule's `regex`; named captures become fields.",
          "type": "string",
          "const": "regex"
        },
        {
          "description": "nginx `combined` access log.",
          "type": "string",
          "const": "nginx_combined"
        },
        {
          "description": "Apache `combined` access log.",
          "type": "string",
          "const": "apache_combined"
        }
      ]
    },
    "PresetSelection": {
      "description": "`presets = \"auto\"` or `presets = [\"linux-core\", \"auto\"]`.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "RateLimit": {
      "description": "`rate_limit = { events_per_second = 500, burst = 2000 }`: a token bucket per rule.",
      "type": "object",
      "properties": {
        "burst": {
          "description": "Events allowed in a burst above the rate; defaults to `events_per_second`.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "default": null,
          "minimum": 0
        },
        "events_per_second": {
          "description": "Sustained events per second, 1 to 1,000,000.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "events_per_second"
      ]
    },
    "Redaction": {
      "description": "`redact = [{ pattern = 'password=\\S+', replace = \"password=[REDACTED]\" }]`.",
      "type": "object",
      "properties": {
        "pattern": {
          "description": "Regular expression; every match is replaced before the event is buffered.",
          "type": "string"
        },
        "replace": {
          "description": "Literal replacement text (no `$1` expansion). Default `[REDACTED]`.",
          "type": "string",
          "default": "[REDACTED]"
        }
      },
      "additionalProperties": false,
      "required": [
        "pattern"
      ]
    },
    "Rule": {
      "description": "One `[[rule]]` table. Fields that do not apply to the rule's `type` must be left out.",
      "type": "object",
      "properties": {
        "channel": {
          "description": "`wineventlog`: channel name, for example `Security`.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "enabled": {
          "description": "Set to `false` to keep a rule without running it.",
          "type": "boolean",
          "default": true
        },
        "event_ids": {
          "description": "`wineventlog`: event ids to select (empty means all). Ignored if `xpath` is set.",
          "type": "array",
          "default": [],
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        },
        "exclude": {
          "description": "`file`: glob patterns of files to skip. A pattern with a path separator is matched\nagainst the whole path, otherwise against the file name.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "exclude_match": {
          "description": "Drop events matching any of these regular expressions.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "format": {
          "description": "`file`: `lines` (default), `auditd` (audit records merged per event), `utmp` (binary\nwtmp/btmp records) or `lastlog` (binary lastlog, summarised).",
          "$ref": "#/$defs/FileFormat"
        },
        "id": {
          "description": "Unique id, `[a-z0-9][a-z0-9._-]{0,63}`. Sent as `rule_id`; used by `disable_rules`.",
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "include_match": {
          "description": "Keep only events matching at least one of these regular expressions.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "level": {
          "description": "`macos_unified`: `default`, `info` (default) or `debug`.",
          "anyOf": [
            {
              "$ref": "#/$defs/LogLevel"
            },
            {
              "type": "null"
            }
          ]
        },
        "matches": {
          "description": "`journald`: `FIELD=value` matches passed to journalctl (same field is ORed, different\nfields are ANDed).",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "max_line_bytes": {
          "description": "`file`: longest line kept, 256 to 1,048,576 bytes (default 65,536).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "default": null,
          "minimum": 0
        },
        "multiline": {
          "description": "`file`: join continuation lines (stack traces) into one event.",
          "anyOf": [
            {
              "$ref": "#/$defs/MultilineConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "parser": {
          "description": "`file`: how lines become `fields` (default `raw`).",
          "$ref": "#/$defs/ParserKind"
        },
        "paths": {
          "description": "`file`: absolute paths or glob patterns (`*`, `?`, `[a-z]`, `**`).",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "predicate": {
          "description": "`macos_unified`: `log stream --predicate` filter.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "priority_max": {
          "description": "`journald`: keep priorities 0 (emerg) to this value, 0 to 7.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint8",
          "default": null,
          "maximum": 7,
          "minimum": 0
        },
        "rate_limit": {
          "description": "Token bucket; events over the limit are dropped and counted.",
          "anyOf": [
            {
              "$ref": "#/$defs/RateLimit"
            },
            {
              "type": "null"
            }
          ]
        },
        "redact": {
          "description": "Replacements applied before the event is written to the disk buffer.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Redaction"
          }
        },
        "regex": {
          "description": "`file` with `parser = \"regex\"`: the expression; named captures become fields.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "sample_rate": {
          "description": "Fraction of events kept, `0 < sample_rate <= 1` (default 1).",
          "type": "number",
          "format": "double",
          "default": 1.0
        },
        "source_label": {
          "description": "Free-text label sent in `attrs.source_label`, for example `web/nginx`.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "source_type": {
          "description": "Wire `source_type`; defaults per `type`.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "start_at": {
          "description": "`file`: where to start without a checkpoint.",
          "$ref": "#/$defs/StartAt"
        },
        "tags": {
          "description": "Key/value tags sent in `attrs.tags`.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "type": {
          "description": "`file`, `journald`, `wineventlog` or `macos_unified`.",
          "$ref": "#/$defs/RuleKind"
        },
        "units": {
          "description": "`journald`: systemd units, for example `ssh.service` (`.service` is added when there\nis no suffix).",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "xpath": {
          "description": "`wineventlog`: raw XPath filter, for example `*[System[Level<=3]]`.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "type"
      ]
    },
    "RuleKind": {
      "description": "The collector a rule runs.",
      "oneOf": [
        {
          "description": "Tail one or more text files.",
          "type": "string",
          "const": "file"
        },
        {
          "description": "Follow the systemd journal (Linux).",
          "type": "string",
          "const": "journald"
        },
        {
          "description": "Subscribe to a Windows Event Log channel (Windows).",
          "type": "string",
          "const": "wineventlog"
        },
        {
          "description": "Stream the macOS unified log (macOS).",
          "type": "string",
          "const": "macos_unified"
        }
      ]
    },
    "StartAt": {
      "description": "Where a file collector starts when it has no checkpoint.",
      "oneOf": [
        {
          "description": "Only lines written after the agent starts (default).",
          "type": "string",
          "const": "end"
        },
        {
          "description": "The whole existing file.",
          "type": "string",
          "const": "beginning"
        }
      ]
    }
  }
}
